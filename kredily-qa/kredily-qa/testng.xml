<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Kredily HRMS Android Suite" verbose="1">
  <listeners>
    <listener class-name="com.kredily.qa.utils.ReportListener"/>
  </listeners>
  <test name="Core HRMS Journeys" preserve-order="true">
    <classes>
      <class name="com.kredily.qa.tests.LoginTest"/>
      <class name="com.kredily.qa.tests.InvalidLoginTest"/>
      <class name="com.kredily.qa.tests.DashboardTest"/>
      <class name="com.kredily.qa.tests.AttendanceTest"/>
      <class name="com.kredily.qa.tests.LeaveTest"/>
    </classes>
  </test>
</suite>
